diff --git a/common/src/main/java/com/shilapi/xcertplay/BootEntryNotification.kt b/common/src/main/java/com/shilapi/xcertplay/BootEntryNotification.kt
new file mode 100644
index 0000000..014f7f4
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/BootEntryNotification.kt
@@ -0,0 +1,102 @@
+package com.shilapi.xcertplay
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.SystemClock
+import android.util.Log
+import androidx.core.app.NotificationChannelCompat
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+
+/**
+ * Persistent entry point for head units whose launcher hides installed apps.
+ *
+ * Posts a plain ongoing (non-clearable) notification that opens DiPlay when tapped.
+ * This is deliberately NOT a foreground service: a plain notification is held by the
+ * system notification service, so it stays in the shade even if the app process is
+ * killed afterwards, and tapping it relaunches the app.
+ *
+ * A watchdog alarm re-checks periodically: if the notification is gone, it is
+ * re-posted immediately. Alarms are held by the system and survive process death;
+ * a manual "Force stop" clears both alarms and notifications (platform behavior).
+ */
+object BootEntryNotification {
+    private const val TAG = "xcertplay-boot-entry"
+    private const val CHANNEL_ID = "diplay_boot_entry"
+    private const val NOTIFICATION_ID = 0xD1A1
+    private const val WATCHDOG_REQUEST_CODE = 0x9D06
+    internal const val WATCHDOG_INTERVAL_MS = 10L * 60L * 1000L
+
+    /** Post (or re-post) the ongoing entry notification. Safe to call repeatedly. */
+    fun ensurePosted(context: Context) {
+        try {
+            val manager = NotificationManagerCompat.from(context)
+            manager.createNotificationChannel(
+                NotificationChannelCompat.Builder(CHANNEL_ID, NotificationManagerCompat.IMPORTANCE_LOW)
+                    .setName(context.getString(R.string.boot_entry_channel_name))
+                    .build(),
+            )
+            val launch = Intent(context, DiPlayActivity::class.java).apply {
+                addFlags(
+                    Intent.FLAG_ACTIVITY_NEW_TASK or
+                        Intent.FLAG_ACTIVITY_CLEAR_TOP or
+                        Intent.FLAG_ACTIVITY_SINGLE_TOP,
+                )
+            }
+            val tap = PendingIntent.getActivity(
+                context,
+                0,
+                launch,
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+            )
+            val notification = NotificationCompat.Builder(context, CHANNEL_ID)
+                .setSmallIcon(R.drawable.ic_carplay)
+                .setContentTitle(context.getString(R.string.app_name))
+                .setContentText(context.getString(R.string.boot_entry_text))
+                .setOngoing(true)
+                .setContentIntent(tap)
+                .build()
+            manager.notify(NOTIFICATION_ID, notification)
+        } catch (error: RuntimeException) {
+            Log.w(TAG, "Entry notification could not be posted", error)
+        }
+    }
+
+    /** True when our entry notification is currently visible in the shade. */
+    fun isPosted(context: Context): Boolean {
+        return try {
+            NotificationManagerCompat.from(context).activeNotifications
+                .any { it.id == NOTIFICATION_ID }
+        } catch (error: RuntimeException) {
+            Log.w(TAG, "Could not query active notifications", error)
+            true // Do not spam reposts when the query itself fails.
+        }
+    }
+
+    /**
+     * Schedule the next watchdog check. One-shot alarm held by the system, so it
+     * survives the app process being killed; the watchdog receiver re-schedules
+     * itself on every delivery. setAndAllowWhileIdle keeps it working in Doze;
+     * the 10-minute interval stays above the while-idle rate limit.
+     */
+    fun scheduleWatchdog(context: Context) {
+        try {
+            val alarms = context.getSystemService(AlarmManager::class.java) ?: return
+            val check = PendingIntent.getBroadcast(
+                context,
+                WATCHDOG_REQUEST_CODE,
+                Intent(context, BootEntryWatchdogReceiver::class.java),
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+            )
+            alarms.setAndAllowWhileIdle(
+                AlarmManager.ELAPSED_REALTIME_WAKEUP,
+                SystemClock.elapsedRealtime() + WATCHDOG_INTERVAL_MS,
+                check,
+            )
+        } catch (error: RuntimeException) {
+            Log.w(TAG, "Watchdog alarm could not be scheduled", error)
+        }
+    }
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/BootEntryWatchdogReceiver.kt b/common/src/main/java/com/shilapi/xcertplay/BootEntryWatchdogReceiver.kt
new file mode 100644
index 0000000..21a0821
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/BootEntryWatchdogReceiver.kt
@@ -0,0 +1,22 @@
+package com.shilapi.xcertplay
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+
+/**
+ * Watchdog for the persistent DiPlay entry notification.
+ *
+ * Fired by a system-held AlarmManager alarm (see [BootEntryNotification.scheduleWatchdog]):
+ * if the notification is no longer in the shade, re-post it immediately, then schedule
+ * the next check. The alarm survives the app process being killed; a manual "Force stop"
+ * clears alarms and notifications together (platform behavior).
+ */
+class BootEntryWatchdogReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (!BootEntryNotification.isPosted(context)) {
+            BootEntryNotification.ensurePosted(context)
+        }
+        BootEntryNotification.scheduleWatchdog(context)
+    }
+}
